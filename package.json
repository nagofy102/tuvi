{
  "name": "tuvi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "engine:build": "node scripts/build-vietnamese-engine.mjs",
    "engine:check": "node scripts/build-vietnamese-engine.mjs --check",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "npm run engine:check && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit:tech": "vitest run --config vitest.audit.config.ts",
    "audit:reference": "node scripts/run-reference-diff.mjs",
    "audit:sources": "node scripts/audit-source-registry.mjs",
    "audit:competitors": "node scripts/run-competitor-diff.mjs",
    "format:check": "prettier --check src tests scripts package.json tsconfig.json next.config.ts playwright.config.ts vitest.config.ts vitest.audit.config.ts postcss.config.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@dqcai/vn-lunar": "1.0.1",
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "framer-motion": "14.1.0",
    "iztro": "2.6.2",
    "lucide-react": "1.55.0",
    "lunar-lite": "0.2.8",
    "lunar-typescript": "1.8.6",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "lighthouse": "13.5.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
